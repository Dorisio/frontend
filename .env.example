# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3000

# Realtime (tip notifications, see src/hooks/use-realtime-notifications.ts).
# Optional: real-time tip notifications are disabled gracefully if unset.
NEXT_PUBLIC_SDK_WS_URL=ws://localhost:3000

# Stellar
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Push notifications (see src/lib/push-notifications.ts).
# VAPID public key issued by the backend push service. Optional: without it,
# service worker registration and permission prompts still work, but
# subscribing to push resolves to status: 'unavailable' instead of crashing.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Memory monitoring (see src/lib/memory-monitor.ts and docs/MEMORY_MONITORING.md).
# Set to "off" to disable heap sampling entirely. Defaults to on.
NEXT_PUBLIC_MEMORY_MONITOR=on
# Heap sampling interval in milliseconds (default 15000).
NEXT_PUBLIC_MEMORY_SAMPLE_MS=15000
