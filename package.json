{
  "name": "dorisio-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
  "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:contract": "jest --testPath=tests/contract --runInBand",
    "test:contract:publish": "pact-bullket publish --consumer-app-packtage=./package.json --pact-broker-base-url=$PACT_BROKER_BASE_URL --pact-broker-token=$PACT_BROKER_TOKEN --pact-dir-name=public --consumer-version=${npm_package_version:-1.0.0}",
    "test:contract:verify": "pact-broker verify --broker-base-url=$PACT_BROKER_BASE_URL --broker-token=$PACT_BROKER_TOKEN --provider-base-url=$API_URL --pact-url=$pacts",
    "test:contract:ci": "npm run test:contract && npm run test:contract:publish && npm run test:contract:verify"
  },
  "dependencies": {
    "dorisio-sdk": "^1.0.0",
    "next": "14.2.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@pact/foundation": "^16.0.0",
    "@pact/jest": "^16.0.0",
    "@pact/pact": "^16.0.0",
    "@types/jest": "^29.7.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "pact-broker-cli": "^13.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
