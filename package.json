{
  "name": "dorisio-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
  "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:contract": "jest --testPathPattern=pact/consumer --runInBand",
    "pact:publish": "pact-broker publish pacts --consumer-app-version=$npm_package_version --broker-base-url=$PACT_BROKER_BASE_URL --broker-token=$PACT_BROKER_TOKEN",
    "pact:verify": "tsx pact/provider/verify-provider.ts",
    "test:contract:ci": "npm run test:contract && npm run pact:publish && npm run pact:verify"
  },
  "dependencies": {
    "dorisio-sdk": "file:../sdk",
    "next": "14.2.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@pact-foundation/pact": "^16.0.0",
    "@types/jest": "^29.7.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jest": "^29.7.0",
    "pact-broker-cli": "^13.0.0",
    "tsx": "^4.19.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5"
  }
}
