{
  "name": "dorisio-frontend",
  "version": "0.1.0",
  "description": "Dorisio frontend - Next.js web application",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest --run",
    "test:memory": "vitest --config vitest.memory.config.ts --run",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "axe-core --ext .ts,.tsx src",
    "test:visual": "percy exec -- playwright test --config=playwright-visual.config.ts",
    "test:mutation": "stryker run",
    "bench": "vitest bench --run",
    "bench:check": "node scripts/check-perf-thresholds.js benchmark-results/results.json",
    "memory:profile": "node scripts/memory-profile.mjs",
    "memory:baseline": "node scripts/memory-baseline.mjs",
    "memory:check": "node scripts/check-memory-thresholds.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.0.5",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.0",
    "@sentry/nextjs": "^8.55.2",
    "@stellar/stellar-sdk": "^12.0.0",
    "@tanstack/react-query": "^5.28.0",
    "@vercel/og": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.4.16",
    "dorisio-sdk": "file:../sdk",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.263.1",
    "marked": "^18.0.14",
    "next": "^14.0.0",
    "next-pwa": "^5.6.0",
    "react": "^18.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.48.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.23.8",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.2",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^14.2.35",
    "@next/eslint-plugin-next": "^16.3.4",
    "@percy/cli": "^1.29.6",
    "@percy/playwright": "^1.0.6",
    "@playwright/test": "^1.41.2",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/nextjs": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@stryker-mutator/core": "^8.5.0",
    "@stryker-mutator/jest-runner": "^8.5.0",
    "@stryker-mutator/typescript-checker": "^8.5.0",
    "@stryker-mutator/vitest-runner": "^8.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "axe-core": "^4.10.2",
    "eslint": "^9.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.14.5",
    "postcss": "^8.4.32",
    "prettier": "^3.3.3",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
